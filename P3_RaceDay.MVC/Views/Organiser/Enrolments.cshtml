@{
    ViewData["Title"] = "Manage Enrolments";
}

<h2>Manage Participant Enrolments</h2>

<p>View participants who have entered RaceDay events.</p>

<div class="card mt-3">
    <div class="card-body">

        <h5 class="card-title">Participant Enrolments</h5>

        <div class="alert alert-info">
            Participant enrolment records will appear here
            once the API and database are connected.
        </div>

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Entry ID</th>
                    <th>Participant</th>
                    <th>Event</th>
                    <th>Entry Date</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="5" class="text-center">
                        No enrolment records available.
                    </td>
                </tr>
            </tbody>
        </table>

    </div>
</div>

<a asp-controller="Organiser"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    Back to Dashboard
</a>