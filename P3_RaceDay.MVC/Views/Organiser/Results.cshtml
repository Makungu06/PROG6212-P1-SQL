@{
    ViewData["Title"] = "Manage Results";
}

<h2>Manage Race Results</h2>

<p>View and manage participant race results.</p>

<div class="card mt-3">
    <div class="card-body">

        <h5 class="card-title">Race Results</h5>

        <div class="alert alert-info">
            Race results will appear here once the API
            and database are connected.
        </div>

        <table class="table table-bordered table-striped">

            <thead class="table-dark">
                <tr>
                    <th>Result ID</th>
                    <th>Participant</th>
                    <th>Event</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                    <th>Race Status</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="6" class="text-center">
                        No race results available.
                    </td>
                </tr>
            </tbody>

        </table>

    </div>
</div>

<a asp-controller="Organiser"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    Back to Dashboard
</a>