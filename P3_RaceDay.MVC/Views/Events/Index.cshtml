@model List<P3_RaceDay.MVC.Controllers.EventViewModel>

@{
    ViewData["Title"] = "Available Events";
}

<div class="container mt-4">
    <h2>Available Race Events</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <p>No events are currently available.</p>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.EventName</h5>
                            <p><strong>Date:</strong> @item.EventDate.ToShortDateString()</p>
                            <p><strong>Venue:</strong> @item.Venue</p>
                            <p><strong>Location:</strong> @item.Location</p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@item.EventID"
                               class="btn btn-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
